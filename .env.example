# Copiá este archivo como ".env" y cambiá las claves. ".env" NO se sube a git.
APP_ENV=production
WEB_PORT=8080
# Clave del usuario de la app (competika_app). Larga y distinta de la del repo.
APP_DB_PASS=cambia-esta-clave
# Clave de root de MariaDB (solo para administrar).
DB_ROOT_PASS=cambia-esta-otra-clave
