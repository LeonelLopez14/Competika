# =====================================================================
# COMPETIKA — reglas de Apache del proyecto (requiere mod_rewrite y
# mod_headers, y AllowOverride All en el VirtualHost: ver apache/).
# Sirve igual en la raíz (competika.local) o en una subcarpeta
# (localhost/Competika), por eso las reglas usan rutas relativas.
# =====================================================================
Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex frontend/index.html index.php index.html

<FilesMatch "\.(sql|md|log|ini|bak|swp|lock|ya?ml)$|^\.|^(Dockerfile|bootstrap\.php|test_conexion\.php)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Páginas, estilos y scripts: el navegador siempre pregunta si cambiaron
    # (evita que quede mostrando una versión vieja después de actualizar el sitio).
    <FilesMatch "\.(html|css|js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1) Seguridad: carpetas internas y clases PHP nunca se sirven por HTTP
    RewriteRule ^(config|core|model|repository|service|database|apache|docker|\.git)(/|$) - [F,NC,L]
    RewriteRule ^controller/[a-z_]+_controller\.php$ - [F,NC,L]
    RewriteRule ^uploads/.*\.(php\d?|phtml|phar)$ - [F,NC,L]

    # Carpeta donde está instalado el sitio ("/" o "/Competika/"), calculada
    # sola: así las redirecciones funcionan en la raíz o en una subcarpeta.
    RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
    RewriteRule ^(.*)$ - [E=BASE:%1]

    # 2) Raíz del sitio -> página de inicio
    RewriteRule ^$ %{ENV:BASE}frontend/index.html [R=302,L]

    # 3) URLs amigables de las páginas (redirigen a la página real)
    RewriteRule ^inicio/?$         %{ENV:BASE}frontend/index.html [R=302,L]
    RewriteRule ^torneos/?$        %{ENV:BASE}frontend/paginas/tournament_search/tournament_search.html [R=302,L]
    RewriteRule ^torneos/([0-9]+)/?$ %{ENV:BASE}frontend/paginas/tournament_view/tournament_view.html?t=$1 [R=302,L]
    RewriteRule ^crear-torneo/?$   %{ENV:BASE}frontend/paginas/tournament_form/tournament_form.html [R=302,L]
    RewriteRule ^dashboard/?$      %{ENV:BASE}frontend/paginas/tournament_dashboard/tournament_dashboard.html [R=302,L]
    RewriteRule ^login/?$          %{ENV:BASE}frontend/paginas/login/login.html [R=302,L]
    RewriteRule ^registro/?$       %{ENV:BASE}frontend/paginas/register/register.html [R=302,L]
    RewriteRule ^perfil/?$         %{ENV:BASE}frontend/paginas/profile/profile.html [R=302,L]
    RewriteRule ^configuracion/?$  %{ENV:BASE}frontend/paginas/profile_configuration/profile_configuration.html [R=302,L]

    # 4) API REST con URLs limpias (reescritura interna, sin redirección)
    #    GET /api/torneos           -> lista      GET /api/torneos/5 -> un torneo
    #    GET /api/notificaciones    -> lista      GET /api/sesion    -> sesión actual
    RewriteRule ^api/torneos/?$            api/tournaments.php?action=list [L,QSA]
    RewriteRule ^api/torneos/([0-9]+)/?$   api/tournaments.php?action=get&id=$1 [L,QSA]
    RewriteRule ^api/notificaciones/?$     api/notifications.php?action=list [L,QSA]
    RewriteRule ^api/sesion/?$             api/session.php [L,QSA]

    # 5) Sin extensión: /api/tournaments -> api/tournaments.php, /controller/login -> login.php
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^((?:api|controller)/[A-Za-z0-9_]+)/?$ $1.php [L,QSA]
</IfModule>
