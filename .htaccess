Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex frontend/index.html index.php index.html

<FilesMatch "\.(sql|md|log|ini|bak|swp|lock|ya?ml)$|^\.|^(Dockerfile|bootstrap\.php|test_conexion\.php)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Páginas, estilos y scripts: el navegador siempre pregunta si cambiaron
    # (evita que quede mostrando una versión vieja después de actualizar el sitio).
    <FilesMatch "\.(html|css|js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^(config|model|repository|database|apache|docker|\.git)(/|$) - [F,NC,L]

    RewriteRule ^$ /frontend/index.html [R=302,L]

    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^((?:api|controller)/[A-Za-z0-9_]+)/?$ $1.php [L,QSA]
</IfModule>
